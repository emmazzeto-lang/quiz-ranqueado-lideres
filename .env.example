# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase
# (Project Settings > API Keys / Data API). O ".env.local" NÃO vai para o Git.

# URL do projeto, ex.: https://abcdefghijk.supabase.co
SUPABASE_URL=

# Chave SECRETA (sb_secret_... ou a antiga "service_role"). Nunca use NEXT_PUBLIC_ aqui:
# ela dá acesso total ao banco e só pode ficar no servidor.
SUPABASE_SECRET_KEY=
